{
    "compilerOptions": {
        "noEmitOnError": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "target": "es2020",
        "sourceMap": true,
        "strict": false,
        "allowJs": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["lib", "node_modules", "dist"]
}
