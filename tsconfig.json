{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src/ts/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "src/ts/lexer.ts"
    ]
}
