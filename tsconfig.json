{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "rootDir": "./src/ts",
        "outDir": "./lib",
        "sourceMap": true,
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "src/ts/**/*.ts"
    ],
    "exclude": [
        "lib/**/*",
        "node_modules"
    ]
}
